APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=data/ticket_assistant.db
KNOWLEDGE_PATH=data/knowledge/runtime

# mock is the safe default. openai_compatible requires all three values below.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prefer a dedicated read-only API key. HTTP is rejected unless the internal
# network risk is explicitly accepted with METABASE_ALLOW_INSECURE_HTTP=true.
METABASE_BASE_URL=
METABASE_AUTH_MODE=api_key
METABASE_API_TOKEN=
METABASE_PERFORMER_FILTER=NIKULINA_VS
METABASE_PERFORMER_LABEL=@Valeri_Nikulina
METABASE_DATABASE_ID=5
METABASE_POLLING_ENABLED=false
METABASE_POLL_INTERVAL_SECONDS=60
METABASE_EMPTY_TICKET_GRACE_SECONDS=300
METABASE_BASELINE_ON_FIRST_RUN=true
METABASE_UTC_OFFSET_HOURS=7
METABASE_TIMEOUT_SECONDS=30
METABASE_ALLOW_INSECURE_HTTP=false

# Confluence Cloud: https://company.atlassian.net/wiki + basic auth.
# Confluence Data Center: its Confluence root URL + bearer auth for a PAT.
# Never paste the token into chat or commit it to the repository.
CONFLUENCE_BASE_URL=https://confluence.eltc.ru/
CONFLUENCE_AUTH_MODE=basic
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_TIMEOUT_SECONDS=30
